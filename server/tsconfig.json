{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true
  },
  // Everything, tests included — this file is what `tsc --noEmit` checks, and vitest only
  // transpiles, so if the tests were dropped here nothing would type-check them at all.
  // The BUILD uses tsconfig.build.json, which excludes them from the emitted output.
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
