# ─────────────────────────────────────────────────────────────────────────────
# SaltStayz HRMS — environment variables
# Copy to server/.env (server vars) and client/.env.local (NEXT_PUBLIC_* vars).
# The values below are for LOCAL DEV. Production notes are marked [PROD].
# ─────────────────────────────────────────────────────────────────────────────

# ── Auth (Better Auth) ──
# Secret used to sign sessions. Must be at least 32 characters.
# [PROD] REQUIRED — the server refuses to start in production without it.
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
# The API's own public base URL (where Better Auth is mounted).
# [PROD] set to the API host, e.g. https://your-api.example.com
BETTER_AUTH_URL=http://localhost:5000

# ── Server ──
# NODE_ENV drives secure cookies, cross-site cookie attributes, trust-proxy, and helmet CSP.
# [PROD] MUST be "production".
NODE_ENV=development

# Port to bind. Locally 5000. [PROD] most hosts inject PORT automatically and the app honours it,
# so you usually don't set this in production.
SERVER_PORT=5000

# PostgreSQL connection string.
# [PROD] REQUIRED — the server refuses to start in production without it. Use your managed Postgres
# (e.g. Neon): postgres://user:pass@host/db?sslmode=require   (SSL is enabled automatically for any
# non-localhost host). Locally this defaults to a Postgres on localhost:5432.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hrms

# Exact origin of the front end (no trailing slash). Drives CORS + Better Auth trusted origins +
# the cross-site cookie. [PROD] set to your Vercel URL, e.g. https://your-app.vercel.app
CLIENT_URL=http://localhost:3000

# ── Client (put in client/.env.local; NEXT_PUBLIC_* is baked in at build time) ──
# Base URL the browser calls. [PROD] set to the API host + /api/v1, e.g.
# https://your-api.example.com/api/v1  (then REDEPLOY the Vercel front end so it takes effect)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# ── Outbound mail — this is the switch for self-service password reset ──
# Nothing in this app could send an email before this existed, so the reset feature is built but
# OFF until a provider is named here. With MAIL_PROVIDER=none the login screen does not offer the
# "Forgot password?" link at all (GET /api/v1/password-reset/capabilities reports false) and the two
# reset endpoints answer normally while doing nothing — deliberately, so the response never becomes
# a way of probing how the server is set up.
#
#   none    the default. Reset stays switched off.
#   resend  HTTPS to Resend. Needs RESEND_API_KEY and a MAIL_FROM on a domain whose SPF and DKIM
#           records you control, or the codes land in spam.
#   log     DEV ONLY — prints the message, code and all, to the server console. Refused in production.
#   memory  TESTS ONLY — keeps the last message in memory. Refused in production.
# MAIL_PROVIDER=none
# MAIL_FROM=SaltStayz HRMS <no-reply@saltstayz.com>
# RESEND_API_KEY=

# Keys the hash of the one-time codes, so reading the `verification` table is not enough to recover
# them (six digits is a one-million-entry rainbow table against a plain digest).
# REQUIRED whenever MAIL_PROVIDER=resend — in ANY environment, not just production. The fallback
# ends at a literal in config/env.ts and therefore in this repository, so a staging box sending real
# codes to real mailboxes would otherwise protect them with a public key. The server refuses to
# start without it. Generate with: openssl rand -base64 32
# OTP_PEPPER=

# ── Optional background jobs (off by default in dev) ──
# BACKUP_ENABLED=true            # daily DB backup (auto-on in production)
# AUTO_ATTENDANCE_ENABLED=true   # daily auto-attendance (auto-on in production)
