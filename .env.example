# ─────────────────────────────────────────────────────────────────────────────
# SaltStayz HRMS — environment variables
# Copy to server/.env (server vars) and client/.env.local (NEXT_PUBLIC_* vars).
# The values below are for LOCAL DEV. Production notes are marked [PROD].
# ─────────────────────────────────────────────────────────────────────────────

# ── Auth (Better Auth) ──
# Secret used to sign sessions. Must be at least 32 characters.
# [PROD] REQUIRED — the server refuses to start in production without it.
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
# The API's own public base URL (where Better Auth is mounted).
# [PROD] set to the API host, e.g. https://your-api.example.com
BETTER_AUTH_URL=http://localhost:5000

# ── Server ──
# NODE_ENV drives secure cookies, cross-site cookie attributes, trust-proxy, and helmet CSP.
# [PROD] MUST be "production".
NODE_ENV=development

# Port to bind. Locally 5000. [PROD] most hosts inject PORT automatically and the app honours it,
# so you usually don't set this in production.
SERVER_PORT=5000

# Where the SQLite database file lives.
# [PROD] point this at a PERSISTENT VOLUME so the DB survives restarts/redeploys, e.g. /data/hrms.db
# Leave unset locally to use the repo default (server/data/hrms.db).
# DATABASE_PATH=/data/hrms.db

# Exact origin of the front end (no trailing slash). Drives CORS + Better Auth trusted origins +
# the cross-site cookie. [PROD] set to your Vercel URL, e.g. https://your-app.vercel.app
CLIENT_URL=http://localhost:3000

# ── Client (put in client/.env.local; NEXT_PUBLIC_* is baked in at build time) ──
# Base URL the browser calls. [PROD] set to the API host + /api/v1, e.g.
# https://your-api.example.com/api/v1  (then REDEPLOY the Vercel front end so it takes effect)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# ── Optional background jobs (off by default in dev) ──
# BACKUP_ENABLED=true            # daily DB backup (auto-on in production)
# AUTO_ATTENDANCE_ENABLED=true   # daily auto-attendance (auto-on in production)
